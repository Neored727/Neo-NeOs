[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Creating pre-transaction Btrfs snapshot...
When = PreTransaction
Exec = /usr/bin/bash -c 'if command -v snapper >/dev/null 2>&1 && [ -e /etc/snapper/configs/root ]; then snapper --config=root create --type pre --cleanup-algorithm timeline --description "Pre-package-operation-$(date +%Y%m%d_%H%M%S)" || true; fi'
